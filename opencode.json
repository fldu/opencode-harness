{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/space-bunny-free",
  "shell": "/bin/zsh",
  "update": "notify",
  "default_agent": "dispatcher",
  "experimental": {
    "subagent_depth": 2
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git add*", "effect": "allow" },
    { "action": "shell", "resource": "git commit*", "effect": "allow" },
    { "action": "shell", "resource": "git push*main*", "effect": "deny" },
    { "action": "shell", "resource": "git push*master*", "effect": "deny" },
    { "action": "shell", "resource": "git push*develop*", "effect": "deny" },
    { "action": "shell", "resource": "git push*release*", "effect": "deny" },
    { "action": "shell", "resource": "git push*prod*", "effect": "deny" },
    { "action": "shell", "resource": "git push*production*", "effect": "deny" },
    { "action": "shell", "resource": "git push*live*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl apply*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl delete*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl exec*", "effect": "deny" },
    { "action": "shell", "resource": "helm upgrade*", "effect": "deny" },
    { "action": "shell", "resource": "helm install*", "effect": "deny" },
    { "action": "shell", "resource": "terraform apply*", "effect": "deny" },
    { "action": "shell", "resource": "terraform destroy*", "effect": "deny" },
    { "action": "shell", "resource": "docker push*", "effect": "deny" },
    { "action": "shell", "resource": "cargo publish*", "effect": "deny" },
    { "action": "shell", "resource": "npm publish*", "effect": "deny" },
    { "action": "shell", "resource": "curl*169.254.169.254*", "effect": "deny" },
    { "action": "shell", "resource": "curl*metadata.google.internal*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/gcloud/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.kube/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.gnupg/**", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "allow" }
  ]
}